{
  "name": "kafe-siparis-masaustu",
  "productName": "Restoran Sipariş",
  "version": "0.1.0",
  "description": "Restoranlar için adisyon ve sipariş yönetimi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite",
    "build": "vite build",
    "paketle": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/karla": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "com.restoransiparis.panel",
    "productName": "Restoran Sipariş",
    "directories": { "output": "cikti" },
    "files": ["dist/**", "electron/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
